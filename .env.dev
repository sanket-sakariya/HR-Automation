# ============================================
# Environment Configuration for Dev Deployment
# ============================================
# Copy this file to .env.dev and fill in your values
ENV=dev
# Application Settings
APP_NAME=InterviewManagementService
APP_VERSION=2.0.1
APP_PORT=8888
LOG_LEVEL=INFO
SERVICE_NAME=interview-management-service

# ============================================
# Kubernetes Deployment Configuration
# ============================================
KUBE_NAMESPACE=article-innovator-dev
REPLICAS=1
CPU_LIMIT=0
MEMORY_LIMIT=0
CPU_REQUEST=0
MEMORY_REQUEST=0
SERVICE_TYPE=ClusterIP

# ============================================
# Database Configuration (Managed Database)
# ============================================
# Format: postgresql+asyncpg://user:password@host:port/database
ASYNC_DATABASE_URL=postgresql+asyncpg://sanket:root@localhost:5432/interview_management_service
# Read Replica Database (if using read replica, otherwise same as primary)
ASYNC_READ_DATABASE_URL=postgresql+asyncpg://sanket:root@localhost:5432/interview_management_service
IS_USE_READ_REPLICA=false

# ============================================
# Media & Storage Configuration
# ============================================
MEDIA_PATH=app/media
LOGO_SUBDIR=logo

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=*

# =========================================
# Cache & Messaging (Optional)
# ============================================
WASABI_ENDPOINT_URL=https://s3.us-central-1.wasabisys.com
WASABI_ACCESS_KEY_ID=5M5IWDOXB3WSIC1H5KR8
WASABI_SECRET_ACCESS_KEY=1F9gBCUZOg7GO026gMU84JWpV4YP66lRdaKnUMXZ
BACKUP_BUCKET_NAME=migration-files
MIGRATION_BUCKET_NAME=migration-files
WASABI_REGION=us-central-1

# ============================================
# Postgres Configuration
# ============================================
IS_POSTGRES_ENABLED=true
IS_BACKUP_ENABLED=false

# ============================================
# interview Endpoints
# ============================================
IS_DEMO_ENDPOINTS_ENABLED=false

# ============================================
# Redis Cache Configuration
# ============================================
IS_RABBITMQ_ENABLED=false
IS_QUEUE_LOG=false
RABBITMQ_URL=amqp://botxbyte:324W2O14GGBlhh@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://botxbyte:324W2O14GGBlhh@rabbitmq:15672
RABBITMQ_QUEUE_NAMES=interview_management_queue,log_queue

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_URL=redis://:5FnMKLLb39cHhK@redis:6379/0
IS_REDIS_CACHE_ENABLED=false
REDIS_CACHE_TTL=300

# ============================================
# APISIX Gateway Configuration
# ============================================
APISIX_ADMIN_URL=http://apisix:9180
APISIX_ADMIN_API_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_JWT_SECRET=oQGHYpcrkkSs5DouLIvxfnJ4ZjqRk4jk
APISIX_ROUTE_NAME=interview-management-route
IS_APISIX_ENABLED=false
USE_INDIVIDUAL_APISIX_ROUTES=false
# Public paths (comma-separated, no authentication required)
APISIX_PUBLIC_PATHS=/interview-management-service/api/v1/health/,/interview-management-service/openapi.json,/interview-management-service/docs,/interview-management-service/redoc,/interview-management-service/apisix.csv,/interview-management-service/api/v1/interview-as/


GEMINI_API_KEY=AIzaSyDcdh65_khy6jmNEkkc53UekkJZjhjIV0E
MODEL_ID=gemini-2.5-flash-native-audio-preview-12-2025