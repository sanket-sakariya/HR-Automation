# Application
ENV=development
APP_NAME=DemoManagementService
APP_VERSION=1.0.0
PORT=8801
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demo_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/demo_management_db

# Database URLs (will be auto-constructed, but you can override)
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/demo_management_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/demo_management_db

# Read Replica (if using, otherwise same as above)
READ_DATABASE_URL=postgresql+psycopg2://postgres:your_actual_password_here@localhost:5432/demo_management_db
ASYNC_READ_DATABASE_URL=postgresql+asyncpg://postgres:your_actual_password_here@localhost:5432/demo_management_db
# [x]: Is it for user management service only right? 

# CORS
CORS_ORIGINS=*

# [x]: Why we use this?

# Redis
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/ 

# External Services