# Environment Configuration for Dev Deployment
# ============================================
# Copy this file to .env.dev and fill in your values

# Environment
ENV=dev

# Application Settings
APP_NAME=DemoManagementService
APP_VERSION=2.0.1
PORT=8801
LOG_LEVEL=INFO
STATUS=active
SERVICE_NAME=demo-management-service

# ============================================
# Kubernetes Deployment Configuration
# ============================================

# Kubernetes Namespace
KUBE_NAMESPACE=testing

# Deployment Configuration
REPLICAS=2
APP_PORT=8801

# Resource Limits
CPU_LIMIT=500m
MEMORY_LIMIT=512Mi

# Resource Requests
CPU_REQUEST=250m
MEMORY_REQUEST=256Mi

# Service Type (ClusterIP, LoadBalancer, NodePort)
SERVICE_TYPE=ClusterIP

# ============================================
# Database Configuration (Managed Database)
# ============================================
# Replace these with your managed database credentials

# Primary Database (Managed PostgreSQL)
POSTGRES_HOST=newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com
POSTGRES_PORT=25060
POSTGRES_DB=demo_management_db
POSTGRES_USER=doadmin
POSTGRES_PASSWORD=AVNS_TxNXuFII77CZ1Q_96v3

# Database URLs (will be constructed from above, but you can override)
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://doadmin:AVNS_TxNXuFII77CZ1Q_96v3@newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com:25060/demo_management_db?sslmode=prefer

# Async Database URL (for async operations)
# Format: postgresql+asyncpg://user:password@host:port/database
ASYNC_DATABASE_URL=postgresql+asyncpg://doadmin:AVNS_TxNXuFII77CZ1Q_96v3@newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com:25060/demo_management_db

# Read Replica Database (if using read replica, otherwise same as primary)
POSTGRES_READ_HOST=newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com
POSTGRES_READ_PORT=25060
POSTGRES_READ_DB=demo_management_db
POSTGRES_READ_USER=doadmin
POSTGRES_READ_PASSWORD=AVNS_TxNXuFII77CZ1Q_96v3
READ_DATABASE_URL=postgresql+psycopg2://doadmin:AVNS_TxNXuFII77CZ1Q_96v3@newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com:25060/demo_management_db?sslmode=prefer
ASYNC_READ_DATABASE_URL=postgresql+asyncpg://doadmin:AVNS_TxNXuFII77CZ1Q_96v3@newsbreak-scraper-data-do-user-20303744-0.m.db.ondigitalocean.com:25060/demo_management_db

# Database Routing
USE_READ_REPLICA=false

# ============================================
# Media & Storage Configuration
# ============================================
MEDIA_PATH=app/media
LOGO_SUBDIR=logo

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=*

# ============================================
# Cache & Messaging (Optional)
# ============================================
# REDIS_URL=redis://localhost:6379/0
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# QUEUE_LOG=false

