# Kubernetes Deployment Configuration for demo-management-service (PRODUCTION)

# Kubernetes Namespace
KUBE_NAMESPACE=default

# Application Port (from your run.py - PORT=8801)
APP_PORT=8801

# Replica Configuration (Higher for production)
REPLICAS=3

# Resource Limits (Higher for production)
CPU_LIMIT=1000m
MEMORY_LIMIT=1Gi

# Resource Requests (Higher for production)
CPU_REQUEST=500m
MEMORY_REQUEST=512Mi

# Docker Image Configuration
DOCKER_IMAGE_TAG=v1.1

# Service Configuration
SERVICE_TYPE=ClusterIP
