# Kubernetes Deployment Configuration for demo-management-service

# Kubernetes Namespace
KUBE_NAMESPACE=default

# Application Port (from your run.py - PORT=8801)
APP_PORT=8801

# Replica Configuration
REPLICAS=0

# Resource Limits
CPU_LIMIT=500m
MEMORY_LIMIT=512Mi

# Resource Requests
CPU_REQUEST=250m
MEMORY_REQUEST=256Mi

# Docker Image Configuration
DOCKER_IMAGE_TAG=latest

# Service Configuration
SERVICE_TYPE=ClusterIP
